CREATE TABLE ChatMessage (
    id TEXT NOT NULL PRIMARY KEY,
    role TEXT NOT NULL, -- USER, ASSISTANT
    content TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL,
    deviceId TEXT NOT NULL,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL DEFAULT 'SYNCED'
);

CREATE INDEX idx_chat_timestamp ON ChatMessage(timestamp DESC);

-- Get all chat messages (excluding deleted)
selectAllChatMessages:
SELECT * FROM ChatMessage
WHERE isDeleted = 0
ORDER BY timestamp ASC;

-- Get chat message by id
selectChatMessageById:
SELECT * FROM ChatMessage
WHERE id = ? AND isDeleted = 0;

-- Insert chat message
insertChatMessage:
INSERT OR REPLACE INTO ChatMessage(id, role, content, timestamp, version, updatedAt, deviceId, isDeleted, syncState)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Update chat message
updateChatMessage:
UPDATE ChatMessage
SET role = ?, content = ?, timestamp = ?, version = version + 1, updatedAt = ?, syncState = 'PENDING'
WHERE id = ?;

-- Delete chat message (soft delete)
deleteChatMessage:
UPDATE ChatMessage
SET isDeleted = 1, syncState = 'PENDING', updatedAt = ?
WHERE id = ?;

-- Delete all chat messages
deleteAllChatMessages:
DELETE FROM ChatMessage;

-- Get pending sync chat messages
selectPendingChatMessages:
SELECT * FROM ChatMessage
WHERE syncState = 'PENDING' OR syncState = 'CONFLICT';

-- Update sync state
updateChatMessageSyncState:
UPDATE ChatMessage
SET syncState = ?
WHERE id = ?;

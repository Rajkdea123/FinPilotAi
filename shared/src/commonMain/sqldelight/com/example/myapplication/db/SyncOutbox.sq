CREATE TABLE SyncOutbox (
    id TEXT NOT NULL PRIMARY KEY,
    tableName TEXT NOT NULL,
    recordId TEXT NOT NULL,
    operation TEXT NOT NULL, -- CREATE, UPDATE, DELETE
    payload TEXT NOT NULL, -- JSON payload
    createdAt INTEGER NOT NULL,
    isProcessed INTEGER NOT NULL DEFAULT 0,
    processedAt INTEGER
);

CREATE INDEX idx_sync_outbox_processed ON SyncOutbox(isProcessed, createdAt);

-- Get all pending sync outbox entries
selectPendingSyncOutbox:
SELECT * FROM SyncOutbox
WHERE isProcessed = 0
ORDER BY createdAt ASC;

-- Get sync outbox entry by id
selectSyncOutboxById:
SELECT * FROM SyncOutbox
WHERE id = ?;

-- Insert sync outbox entry
insertSyncOutbox:
INSERT OR REPLACE INTO SyncOutbox(id, tableName, recordId, operation, payload, createdAt, isProcessed, processedAt)
VALUES(?, ?, ?, ?, ?, ?, ?, ?);

-- Mark sync outbox entry as processed
markSyncOutboxProcessed:
UPDATE SyncOutbox
SET isProcessed = 1, processedAt = ?
WHERE id = ?;

-- Delete processed sync outbox entries (cleanup)
deleteProcessedSyncOutbox:
DELETE FROM SyncOutbox
WHERE isProcessed = 1 AND processedAt < ?;

-- Get sync outbox entries by table
selectSyncOutboxByTable:
SELECT * FROM SyncOutbox
WHERE tableName = ? AND isProcessed = 0
ORDER BY createdAt ASC;

-- Delete all sync outbox
deleteAllSyncOutbox:
DELETE FROM SyncOutbox;

CREATE TABLE Insight (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    category TEXT NOT NULL,
    date INTEGER NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL,
    deviceId TEXT NOT NULL,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL DEFAULT 'SYNCED'
);

-- Get all insights (excluding deleted)
selectAllInsights:
SELECT * FROM Insight
WHERE isDeleted = 0
ORDER BY date DESC;

-- Get insight by id
selectInsightById:
SELECT * FROM Insight
WHERE id = ? AND isDeleted = 0;

-- Get insights by category
selectInsightsByCategory:
SELECT * FROM Insight
WHERE isDeleted = 0 AND category = ?
ORDER BY date DESC;

-- Insert insight
insertInsight:
INSERT INTO Insight(id, title, content, category, date, version, updatedAt, deviceId, isDeleted, syncState)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Update insight
updateInsight:
UPDATE Insight
SET title = ?, content = ?, category = ?, date = ?, version = version + 1, updatedAt = ?, syncState = 'PENDING'
WHERE id = ?;

-- Delete insight (soft delete)
deleteInsight:
UPDATE Insight
SET isDeleted = 1, syncState = 'PENDING', updatedAt = ?
WHERE id = ?;

-- Delete all insights
deleteAllInsights:
DELETE FROM Insight;

-- Get pending sync insights
selectPendingInsights:
SELECT * FROM Insight
WHERE syncState = 'PENDING' OR syncState = 'CONFLICT';

-- Update sync state
updateInsightSyncState:
UPDATE Insight
SET syncState = ?
WHERE id = ?;

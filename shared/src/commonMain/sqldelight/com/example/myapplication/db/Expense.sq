CREATE TABLE Expense (
    id TEXT NOT NULL PRIMARY KEY,
    amount INTEGER NOT NULL, -- stored as paise (Long)
    category TEXT NOT NULL,
    paymentMethod TEXT NOT NULL,
    date INTEGER NOT NULL, -- timestamp in milliseconds
    description TEXT NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL, -- timestamp in milliseconds
    deviceId TEXT NOT NULL,
    isDeleted INTEGER NOT NULL DEFAULT 0, -- 0 = false, 1 = true (tombstone)
    syncState TEXT NOT NULL DEFAULT 'SYNCED' -- SYNCED, PENDING, CONFLICT
);

CREATE INDEX idx_expense_date ON Expense(date DESC);
CREATE INDEX idx_expense_category ON Expense(category);
CREATE INDEX idx_expense_sync ON Expense(syncState, isDeleted);

-- Get all expenses (excluding deleted)
selectAllExpenses:
SELECT * FROM Expense
WHERE isDeleted = 0
ORDER BY date DESC;

-- Get expense by id
selectExpenseById:
SELECT * FROM Expense
WHERE id = ? AND isDeleted = 0;

-- Insert expense
insertExpense:
INSERT OR REPLACE INTO Expense(id, amount, category, paymentMethod, date, description, version, updatedAt, deviceId, isDeleted, syncState)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Update expense
updateExpense:
UPDATE Expense
SET amount = ?, category = ?, paymentMethod = ?, date = ?, description = ?, version = version + 1, updatedAt = ?, syncState = 'PENDING'
WHERE id = ?;

-- Delete expense (soft delete)
deleteExpense:
UPDATE Expense
SET isDeleted = 1, syncState = 'PENDING', updatedAt = ?
WHERE id = ?;

-- Filter expenses by date range
selectExpensesByDateRange:
SELECT * FROM Expense
WHERE isDeleted = 0
AND date >= ? AND date <= ?
ORDER BY date DESC;

-- Filter expenses by category
selectExpensesByCategory:
SELECT * FROM Expense
WHERE isDeleted = 0 AND category = ?
ORDER BY date DESC;

-- Filter expenses by payment method
selectExpensesByPaymentMethod:
SELECT * FROM Expense
WHERE isDeleted = 0 AND paymentMethod = ?
ORDER BY date DESC;

-- Search expenses by description
searchExpenses:
SELECT * FROM Expense
WHERE isDeleted = 0 AND description LIKE ?
ORDER BY date DESC;

-- Get expenses for a specific month (grouped by day)
selectExpensesByMonth:
SELECT * FROM Expense
WHERE isDeleted = 0
AND strftime('%Y-%m', date/1000, 'unixepoch') = ?
ORDER BY date DESC;

-- Get category totals for a month
selectCategoryTotalsByMonth:
SELECT category, SUM(amount)
FROM Expense
WHERE isDeleted = 0
AND strftime('%Y-%m', date/1000, 'unixepoch') = ?
GROUP BY category;

-- Get month summary (total spent, by category)
selectMonthSummary:
SELECT
    SUM(amount) AS totalSpent,
    COUNT(*) AS transactionCount
FROM Expense
WHERE isDeleted = 0
AND strftime('%Y-%m', date/1000, 'unixepoch') = ?;

-- Get expenses for a specific week
selectExpensesByWeek:
SELECT * FROM Expense
WHERE isDeleted = 0
AND date >= ? AND date <= ?
ORDER BY date DESC;

-- Get expenses for a specific year
selectExpensesByYear:
SELECT * FROM Expense
WHERE isDeleted = 0
AND strftime('%Y', date/1000, 'unixepoch') = ?
ORDER BY date DESC;

-- Get pending sync expenses
selectPendingExpenses:
SELECT * FROM Expense
WHERE syncState = 'PENDING' OR syncState = 'CONFLICT';

-- Update sync state
updateExpenseSyncState:
UPDATE Expense
SET syncState = ?
WHERE id = ?;

-- Delete all expenses
deleteAllExpenses:
DELETE FROM Expense;

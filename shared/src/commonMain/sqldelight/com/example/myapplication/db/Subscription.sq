CREATE TABLE Subscription (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    amount INTEGER NOT NULL, -- stored as paise
    category TEXT NOT NULL,
    billingCycle TEXT NOT NULL, -- MONTHLY, YEARLY, WEEKLY
    nextBillingDate INTEGER NOT NULL,
    isActive INTEGER NOT NULL DEFAULT 1,
    version INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL,
    deviceId TEXT NOT NULL,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    syncState TEXT NOT NULL DEFAULT 'SYNCED'
);

CREATE INDEX idx_subscription_active ON Subscription(isActive);

-- Get all subscriptions (excluding deleted)
selectAllSubscriptions:
SELECT * FROM Subscription
WHERE isDeleted = 0
ORDER BY nextBillingDate ASC;

-- Get subscription by id
selectSubscriptionById:
SELECT * FROM Subscription
WHERE id = ? AND isDeleted = 0;

-- Get active subscriptions
selectActiveSubscriptions:
SELECT * FROM Subscription
WHERE isDeleted = 0 AND isActive = 1
ORDER BY nextBillingDate ASC;

-- Insert subscription
insertSubscription:
INSERT INTO Subscription(id, name, amount, category, billingCycle, nextBillingDate, isActive, version, updatedAt, deviceId, isDeleted, syncState)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Update subscription
updateSubscription:
UPDATE Subscription
SET name = ?, amount = ?, category = ?, billingCycle = ?, nextBillingDate = ?, isActive = ?, version = version + 1, updatedAt = ?, syncState = 'PENDING'
WHERE id = ?;

-- Delete subscription (soft delete)
deleteSubscription:
UPDATE Subscription
SET isDeleted = 1, syncState = 'PENDING', updatedAt = ?
WHERE id = ?;

-- Delete all subscriptions
deleteAllSubscriptions:
DELETE FROM Subscription;

-- Get pending sync subscriptions
selectPendingSubscriptions:
SELECT * FROM Subscription
WHERE syncState = 'PENDING' OR syncState = 'CONFLICT';

-- Update sync state
updateSubscriptionSyncState:
UPDATE Subscription
SET syncState = ?
WHERE id = ?;
